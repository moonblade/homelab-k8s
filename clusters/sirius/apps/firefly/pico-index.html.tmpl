<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pico</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💸</text></svg>">
<script>if('serviceWorker' in navigator)navigator.serviceWorker.getRegistrations().then(rs=>rs.forEach(r=>r.unregister()));</script>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --bg: #0d1117; --surface: #161b22; --border: #21262d;
    --text: #c9d1d9; --muted: #8b949e;
    --blue: #58a6ff; --green: #3fb950; --red: #f85149; --yellow: #d29922;
  }
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: var(--bg); color: var(--text); min-height: 100vh; padding: 16px; font-size: 14px; }
  .header { display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 20px; flex-wrap: wrap; gap: 8px; }
  .header h1 { font-size: 20px; color: var(--blue); font-weight: 700; }
  .header-right { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .month-nav { display: flex; align-items: center; gap: 8px; }
  .month-nav button { background: var(--surface); border: 1px solid var(--border);
    color: var(--text); padding: 4px 10px; border-radius: 6px; cursor: pointer; font-size: 13px; }
  .month-nav button:hover { border-color: var(--blue); color: var(--blue); }
  .month-label { font-size: 14px; font-weight: 600; color: var(--text); min-width: 130px; text-align: center; }
  #status { font-size: 12px; color: var(--muted); }
  #status.err { color: var(--red); }
  .stats { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 16px; }
  .stat { background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
    padding: 12px 16px; flex: 1; min-width: 100px; }
  .stat .s-label { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.4px; }
  .stat .s-value { font-size: 22px; font-weight: 700; margin-top: 4px; }
  .c-blue { color: var(--blue); } .c-yellow { color: var(--yellow); }
  .main-grid { display: grid; grid-template-columns: 260px 1fr; gap: 16px; align-items: start; }
  @media (max-width: 700px) { .main-grid { grid-template-columns: 1fr; } }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 16px; }
  .card-title { font-size: 11px; font-weight: 600; color: var(--muted);
    text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px; }
  .pie-wrap { position: relative; width: 180px; height: 180px; margin: 0 auto 12px; }
  #pieCanvas { width: 180px; height: 180px; display: block; }
  .pie-center { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
    text-align: center; pointer-events: none; }
  .pie-center .total-amt { font-size: 14px; font-weight: 700; color: var(--text); }
  .pie-center .total-lbl { font-size: 10px; color: var(--muted); }
  .legend { display: flex; flex-direction: column; gap: 4px; }
  .legend-item { display: flex; align-items: center; gap: 6px; cursor: pointer;
    padding: 3px 4px; border-radius: 4px; transition: background 0.1s; }
  .legend-item:hover { background: rgba(88,166,255,0.08); }
  .legend-item.dimmed { opacity: 0.3; }
  .legend-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
  .legend-name { flex: 1; font-size: 12px; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .legend-amt { font-size: 11px; color: var(--muted); font-family: monospace; }
  .legend-pct { font-size: 10px; color: var(--muted); width: 32px; text-align: right; }
  .section-header { display: flex; align-items: center; gap: 10px; margin-bottom: 10px;
    border-bottom: 1px solid var(--border); padding-bottom: 8px; }
  .section-header h2 { font-size: 13px; font-weight: 600; color: var(--muted);
    text-transform: uppercase; letter-spacing: 0.4px; }
  .badge { font-size: 11px; font-weight: 700; padding: 2px 7px; border-radius: 10px;
    background: var(--yellow); color: #0d1117; }
  .badge.ok { background: var(--green); }
  .filter-bar { display: flex; gap: 8px; margin-bottom: 12px; flex-wrap: wrap; }
  .filter-btn { background: var(--surface); border: 1px solid var(--border); color: var(--muted);
    padding: 4px 12px; border-radius: 20px; cursor: pointer; font-size: 12px; transition: all 0.15s; }
  .filter-btn.active { background: var(--blue); border-color: var(--blue); color: #0d1117; font-weight: 600; }
  .tx-list { display: flex; flex-direction: column; gap: 3px; }
  .tx-item { display: grid; grid-template-columns: 1fr auto; align-items: start;
    gap: 8px; padding: 9px 10px; border-radius: 7px; border: 1px solid transparent; }
  .tx-item:hover { background: rgba(88,166,255,0.04); border-color: var(--border); }
  .tx-item.uncat { border-left: 3px solid var(--yellow); padding-left: 8px; }
  .tx-item.ignored { opacity: 0.38; }
  .tx-desc { font-size: 13px; color: var(--text); font-weight: 500;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tx-meta { display: flex; align-items: center; gap: 6px; margin-top: 3px; flex-wrap: wrap; }
  .tx-date { font-size: 11px; color: var(--muted); }
  .tx-cat { font-size: 11px; padding: 1px 6px; border-radius: 8px;
    background: rgba(88,166,255,0.12); color: var(--blue); font-weight: 500; }
  .tx-cat.none { background: rgba(210,153,34,0.15); color: var(--yellow); }
  .tx-tag-ign { font-size: 10px; padding: 1px 6px; border-radius: 8px;
    background: rgba(139,148,158,0.15); color: var(--muted); }
  .tx-right { display: flex; align-items: flex-start; gap: 6px; flex-shrink: 0; padding-top: 1px; }
  .tx-amount { font-size: 14px; font-weight: 600; font-family: monospace; color: var(--red); }
  .tx-amount.deposit { color: var(--green); }
  .tx-actions { display: flex; gap: 4px; }
  .btn-sm { border: 1px solid var(--border); background: transparent; color: var(--muted);
    padding: 4px 7px; border-radius: 5px; cursor: pointer; font-size: 15px;
    transition: all 0.15s; line-height: 1; }
  .btn-sm:hover { border-color: var(--blue); }
  .btn-sm.ign { border-color: var(--muted); background: rgba(139,148,158,0.1); }
  .empty { color: var(--muted); text-align: center; padding: 32px; font-style: italic; font-size: 13px; }
  .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.75);
    z-index: 100; align-items: flex-end; justify-content: center; }
  .modal-overlay.open { display: flex; }
  .modal-box { background: var(--surface); border: 1px solid var(--border);
    border-radius: 18px 18px 0 0; width: 100%; max-width: 540px;
    padding: 20px 16px 40px; max-height: 82vh; overflow-y: auto; }
  .modal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
  .modal-title { font-size: 16px; font-weight: 700; color: var(--text); }
  .modal-close { background: var(--bg); border: 1px solid var(--border); color: var(--muted);
    font-size: 16px; cursor: pointer; padding: 4px 10px; border-radius: 8px; }
  .cat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  @media (min-width: 380px) { .cat-grid { grid-template-columns: repeat(4, 1fr); } }
  .cat-grid-btn { background: var(--bg); border: 2px solid var(--border);
    border-radius: 12px; padding: 14px 6px 10px; cursor: pointer;
    display: flex; flex-direction: column; align-items: center; gap: 7px;
    transition: all 0.15s; min-height: 78px; width: 100%; }
  .cat-grid-btn:active { transform: scale(0.95); }
  .cat-grid-btn:hover { border-color: var(--blue); background: rgba(88,166,255,0.08); }
  .cat-grid-btn.selected { border-color: var(--blue); background: rgba(88,166,255,0.18); }
  .cat-grid-icon { font-size: 26px; line-height: 1; }
  .cat-grid-label { font-size: 10px; color: var(--muted); text-align: center; line-height: 1.3; word-break: break-word; }
  .cat-grid-btn.selected .cat-grid-label { color: var(--blue); font-weight: 600; }
</style>
</head>
<body>

<div class="header">
  <h1>Pico</h1>
  <div class="header-right">
    <div class="month-nav">
      <button id="prevMonth">&#x2039;</button>
      <span class="month-label" id="monthLabel"></span>
      <button id="nextMonth">&#x203a;</button>
    </div>
    <span id="status"></span>
  </div>
</div>

<div class="stats">
  <div class="stat"><div class="s-label">Total Spent</div><div class="s-value c-blue" id="statTotal">—</div></div>
  <div class="stat"><div class="s-label">Transactions</div><div class="s-value" id="statCount">—</div></div>
</div>

<div class="main-grid">
  <div>
    <div class="card">
      <div class="card-title">Spending by Category</div>
      <div class="pie-wrap">
        <canvas id="pieCanvas" width="360" height="360"></canvas>
        <div class="pie-center">
          <div class="total-amt" id="pieCenterAmt">—</div>
          <div class="total-lbl">total</div>
        </div>
      </div>
      <div class="legend" id="legend"></div>
    </div>
  </div>
  <div>
    <div class="card">
      <div class="section-header">
        <h2>Transactions</h2>
        <span class="badge" id="uncatBadge" style="display:none"></span>
      </div>
      <div class="filter-bar">
        <button class="filter-btn active" data-filter="all">All</button>
        <button class="filter-btn" data-filter="uncategorized">Uncategorized</button>
        <button class="filter-btn" data-filter="ignored">Ignored</button>
      </div>
      <div class="tx-list" id="txList"><div class="empty">Loading…</div></div>
    </div>
  </div>
</div>

<div id="catModal" class="modal-overlay">
  <div class="modal-box">
    <div class="modal-header">
      <span class="modal-title">Pick Category</span>
      <button class="modal-close" onclick="closeModal()">&#x2715;</button>
    </div>
    <div class="cat-grid" id="catGrid"></div>
  </div>
</div>

<script>
const FIREFLY_URL   = "https://firefly.sirius.moonblade.work";
const FIREFLY_TOKEN = "${FIREFLY_TOKEN}";

const CAT_ICONS = {
  "Bills":"🧾","Family":"👨‍👩‍👧","Food":"🍜","Food & Dining":"🍜",
  "Friends":"🤝","Fuel":"⛽","Groceries":"🛒","Health":"💊",
  "Home":"🏠","Investments":"📈","Medical":"🏥","Misc":"📦",
  "Personal Care":"🪥","Rent":"🏘️","Shopping":"🛍️","Transfer":"↔️",
  "Transport":"🚌","Travel":"✈️","Vehicle":"🚗","Wedding":"💍",
  "Subscriptions":"📱","Utilities":"💡","Education":"📚","Entertainment":"🎬",
};
function catIcon(n) { return CAT_ICONS[n] || "🏷️"; }

const JUNK_CATS   = new Set(["--- quit ---","ctrl-c","ctrl-d","--quit--","--pick--"]);
const IGNORE_TAGS = ["ignore","self-transfer"];
const COLORS = [
  "#58a6ff","#3fb950","#bc8cff","#ffa657","#79c0ff","#56d364",
  "#ff7b72","#e3b341","#d2a8ff","#ffb077","#45b8ac","#c74375","#EFC050","#FF6F61",
];

let currentDate=new Date(), allTx=[], categories=[], categoryNames=[];
let activeFilter="all", activeLegendCat=null, pieSlices=[];

function isExcluded(tx) { return tx.tags.some(t=>IGNORE_TAGS.includes(t)); }
function fmtINR(v) {
  return "₹"+Math.round(v).toLocaleString("en-IN");
}
function fmtINRShort(v) {
  if (v>=100000) return "₹"+(v/100000).toFixed(1)+"L";
  if (v>=1000)   return "₹"+(v/1000).toFixed(1)+"K";
  return "₹"+Math.round(v);
}
function esc(s) { return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;"); }
function monthRange(d) {
  const y=d.getFullYear(),m=d.getMonth(),pad=n=>String(n).padStart(2,"0");
  return {start:`${y}-${pad(m+1)}-01`,end:`${y}-${pad(m+1)}-${pad(new Date(y,m+1,0).getDate())}`};
}
function setStatus(msg,isErr) { const el=document.getElementById("status"); el.textContent=msg; el.className=isErr?"err":""; }

async function api(path,opts={}) {
  const r=await fetch(FIREFLY_URL+path,{...opts,headers:{Authorization:"Bearer "+FIREFLY_TOKEN,Accept:"application/vnd.api+json","Content-Type":"application/json",...(opts.headers||{})}});
  if (!r.ok) throw new Error("HTTP "+r.status);
  if (opts.method==="PUT") return r.json().catch(()=>({}));
  return r.json();
}
async function fetchPages(path) {
  let results=[],page=1;
  while(true) {
    const sep=path.includes("?")?"&":"?";
    const data=await api(path+sep+"page="+page+"&limit=50");
    results=results.concat(data.data||[]);
    const meta=data.meta&&data.meta.pagination;
    if (!meta||page>=meta.total_pages) break;
    page++;
  }
  return results;
}

const CACHE_VERSION="v3";
function cacheKey() { const {start}=monthRange(currentDate); return "pico_cache_"+CACHE_VERSION+"_"+start; }
function loadCache() { try{const r=localStorage.getItem(cacheKey());return r?JSON.parse(r):null;}catch(e){return null;} }
function saveCache(txRaw,catRaw,depRaw) { try{localStorage.setItem(cacheKey(),JSON.stringify({ts:Date.now(),txRaw,catRaw,depRaw}));}catch(e){} }

function applyData(txRaw,catRaw,depRaw) {
  categoryNames=catRaw.map(c=>c.attributes.name).filter(n=>!JUNK_CATS.has(n)).sort();
  allTx=[];
  for (const t of txRaw) for (const s of t.attributes.transactions)
    allTx.push({id:t.id,jid:String(s.transaction_journal_id),desc:s.description||"—",
      amount:parseFloat(s.amount),date:(s.date||"").substring(0,10),
      category:s.category_name||null,tags:s.tags||[],type:"withdrawal"});
  for (const t of (depRaw||[])) for (const s of t.attributes.transactions)
    allTx.push({id:t.id,jid:String(s.transaction_journal_id),desc:s.description||"—",
      amount:parseFloat(s.amount),date:(s.date||"").substring(0,10),
      category:s.category_name||null,tags:s.tags||[],type:"deposit"});
  allTx.sort((a,b)=>{
    // Uncategorized withdrawals first, then everything else by date descending
    const aUncat=a.type==="withdrawal"&&!a.category&&!isExcluded(a);
    const bUncat=b.type==="withdrawal"&&!b.category&&!isExcluded(b);
    if(aUncat!==bUncat)return aUncat?-1:1;
    return b.date.localeCompare(a.date);
  });
  buildCategories(); render();
}

async function loadData() {
  const {start,end}=monthRange(currentDate);
  const cached=loadCache();
  if (cached) { applyData(cached.txRaw,cached.catRaw,cached.depRaw||[]); setStatus("Cached · "+Math.round((Date.now()-cached.ts)/1000)+"s ago · refreshing…"); }
  else setStatus("Loading…");
  try {
    const [txRaw,catRaw,depRaw]=await Promise.all([
      fetchPages("/api/v1/transactions?type=withdrawal&start="+start+"&end="+end),
      fetchPages("/api/v1/categories"),
      fetchPages("/api/v1/transactions?type=deposit&start="+start+"&end="+end),
    ]);
    saveCache(txRaw,catRaw,depRaw); applyData(txRaw,catRaw,depRaw);
    setStatus("Updated "+new Date().toLocaleTimeString("en-IN",{hour:"2-digit",minute:"2-digit"}));
  } catch(e) {
    if (cached) setStatus("Cached · "+Math.round((Date.now()-cached.ts)/1000)+"s ago (offline)",true);
    else setStatus("Error: "+e.message,true);
  }
}

function buildCategories() {
  const map={};
  for (const tx of allTx) { if(tx.type!=="withdrawal"||isExcluded(tx))continue; const k=tx.category||"Uncategorized"; map[k]=(map[k]||0)+tx.amount; }
  let ci=0;
  categories=Object.entries(map).sort((a,b)=>b[1]-a[1]).map(([name,total])=>({name,total,color:name==="Uncategorized"?"#d29922":COLORS[ci++%COLORS.length]}));
}

function render() { renderStats(); drawPie(); renderLegend(); renderTxList(); }

function renderStats() {
  const withdrawals=allTx.filter(t=>t.type==="withdrawal"&&!isExcluded(t));
  const total=withdrawals.reduce((s,t)=>s+t.amount,0);
  document.getElementById("statTotal").textContent=fmtINR(total);
  document.getElementById("statCount").textContent=withdrawals.length;
  document.getElementById("uncatBadge").style.display="none";
}

function drawPie() {
  const canvas=document.getElementById("pieCanvas"),ctx=canvas.getContext("2d");
  ctx.clearRect(0,0,canvas.width,canvas.height);
  const total=categories.reduce((s,c)=>s+c.total,0);
  if(!total){document.getElementById("pieCenterAmt").textContent="₹0";pieSlices=[];return;}
  document.getElementById("pieCenterAmt").textContent=fmtINRShort(total);
  const cx=canvas.width/2,cy=canvas.height/2,outerR=cx-8,innerR=outerR*0.54,GAP=0.025;
  let angle=-Math.PI/2; pieSlices=[];
  for(const s of categories){
    const sweep=(s.total/total)*Math.PI*2-GAP; if(sweep<=0)continue;
    pieSlices.push({name:s.name,start:angle,end:angle+sweep,cx,cy,outerR,innerR});
    const dimmed=activeLegendCat&&activeLegendCat!==s.name;
    ctx.beginPath();ctx.moveTo(cx+outerR*Math.cos(angle),cy+outerR*Math.sin(angle));
    ctx.arc(cx,cy,outerR,angle,angle+sweep);ctx.arc(cx,cy,innerR,angle+sweep,angle,true);
    ctx.closePath();ctx.fillStyle=dimmed?s.color+"33":s.color;ctx.fill();angle+=sweep+GAP;
  }
}
function hitTestPie(evt){
  const canvas=document.getElementById("pieCanvas"),rect=canvas.getBoundingClientRect();
  const mx=(evt.clientX-rect.left)*(canvas.width/rect.width),my=(evt.clientY-rect.top)*(canvas.height/rect.height);
  for(const sl of pieSlices){
    const dx=mx-sl.cx,dy=my-sl.cy,dist=Math.sqrt(dx*dx+dy*dy);
    if(dist<sl.innerR||dist>sl.outerR)continue;
    let a=Math.atan2(dy,dx); while(a<sl.start)a+=2*Math.PI;
    if(a<=sl.end)return sl.name;
  }
  return null;
}
document.getElementById("pieCanvas").style.cursor="pointer";
document.getElementById("pieCanvas").addEventListener("click",evt=>{
  const hit=hitTestPie(evt); if(!hit)return;
  activeLegendCat=activeLegendCat===hit?null:hit;
  renderLegend();drawPie();renderTxList();
});

function renderLegend() {
  const total=categories.reduce((s,c)=>s+c.total,0),el=document.getElementById("legend");el.innerHTML="";
  for(const cat of categories){
    const pct=total>0?Math.round((cat.total/total)*100):0,item=document.createElement("div");
    item.className="legend-item"+(activeLegendCat&&activeLegendCat!==cat.name?" dimmed":"");
    item.innerHTML='<span class="legend-dot" style="background:'+cat.color+'"></span><span class="legend-name">'+esc(cat.name)+'</span><span class="legend-amt">'+fmtINRShort(cat.total)+'</span><span class="legend-pct">'+pct+'%</span>';
    item.addEventListener("click",()=>{activeLegendCat=activeLegendCat===cat.name?null:cat.name;renderLegend();drawPie();renderTxList();});
    el.appendChild(item);
  }
}

function renderTxList() {
  const list=document.getElementById("txList");
  let filtered=[...allTx];
  if(activeFilter==="ignored"){
    filtered=filtered.filter(t=>isExcluded(t));
  } else {
    filtered=filtered.filter(t=>!isExcluded(t));
    if(activeFilter==="uncategorized")filtered=filtered.filter(t=>t.type==="withdrawal"&&!t.category);
    if(activeLegendCat){const cf=activeLegendCat==="Uncategorized"?null:activeLegendCat;filtered=filtered.filter(t=>t.type==="withdrawal"&&t.category===cf);}
  }
  if(!filtered.length){list.innerHTML='<div class="empty">No transactions</div>';return;}
  list.innerHTML="";
  for(const tx of filtered){
    const ign=isExcluded(tx),isDeposit=tx.type==="deposit",div=document.createElement("div");
    div.className="tx-item"+(!tx.category&&!ign&&!isDeposit?" uncat":"")+(ign?" ignored":"");
    const catBadge=tx.category?'<span class="tx-cat">'+catIcon(tx.category)+" "+esc(tx.category)+'</span>':(isDeposit?'':'<span class="tx-cat none">Uncategorized</span>');
    const ignBadge=ign?'<span class="tx-tag-ign">'+(tx.tags.includes("self-transfer")?"↔ transfer":"🚫 ignored")+'</span>':"";
    const amtClass="tx-amount"+(isDeposit?" deposit":"");
    div.innerHTML=
      '<div style="min-width:0"><div class="tx-desc">'+esc(tx.desc)+'</div><div class="tx-meta"><span class="tx-date">'+tx.date+'</span>'+catBadge+ignBadge+'</div></div>'+
      '<div class="tx-right"><span class="'+amtClass+'">'+fmtINR(tx.amount)+'</span>'+(isDeposit?'':'<div class="tx-actions"><button class="btn-sm cat-btn">'+catIcon(tx.category)+'</button><button class="btn-sm ign-btn'+(ign?' ign':'')+'">'+( ign?'👁':'🚫')+'</button></div>')+' </div>';
    if(!isDeposit){
      div.querySelector(".cat-btn").addEventListener("click",()=>openModal(tx.id,tx.jid,tx.category||""));
      div.querySelector(".ign-btn").addEventListener("click",()=>toggleIgnore(tx.id,tx.jid));
    }
    list.appendChild(div);
  }
}

function openModal(txId,jid,currentCat) {
  const grid=document.getElementById("catGrid");grid.innerHTML="";
  categoryNames.forEach(c=>{
    const btn=document.createElement("button");
    btn.className="cat-grid-btn"+(c===currentCat?" selected":"");
    btn.innerHTML='<span class="cat-grid-icon">'+catIcon(c)+'</span><span class="cat-grid-label">'+esc(c)+'</span>';
    btn.onclick=()=>saveCategory(txId,jid,c);
    grid.appendChild(btn);
  });
  document.getElementById("catModal").classList.add("open");
}
function closeModal() { document.getElementById("catModal").classList.remove("open"); }
document.getElementById("catModal").addEventListener("click",e=>{if(e.target===document.getElementById("catModal"))closeModal();});

async function saveCategory(txId,jid,cat) {
  closeModal(); setStatus("Saving…");
  try {
    await api("/api/v1/transactions/"+txId,{method:"PUT",body:JSON.stringify({transactions:[{transaction_journal_id:parseInt(jid),category_name:cat}]})});
    const tx=allTx.find(t=>t.jid===jid); if(tx)tx.category=cat;
    buildCategories();render();setStatus("Saved ✓");
  } catch(e){setStatus("Save failed: "+e.message,true);}
}

async function toggleIgnore(txId,jid) {
  const tx=allTx.find(t=>t.jid===jid);if(!tx)return;
  // Remove whichever ignore tag is present ("ignore" or "self-transfer"), or add "ignore"
  const excluded=IGNORE_TAGS.filter(t=>tx.tags.includes(t));
  const wasExcluded=excluded.length>0;
  const newTags=wasExcluded?tx.tags.filter(t=>!IGNORE_TAGS.includes(t)):[...tx.tags,"ignore"];
  setStatus("Updating…");
  try {
    await api("/api/v1/transactions/"+txId,{method:"PUT",body:JSON.stringify({transactions:[{transaction_journal_id:parseInt(jid),tags:newTags}]})});
    tx.tags=newTags;buildCategories();render();setStatus(wasExcluded?"Un-ignored ✓":"Ignored ✓");
  } catch(e){setStatus("Update failed: "+e.message,true);}
}

document.getElementById("prevMonth").addEventListener("click",()=>{currentDate=new Date(currentDate.getFullYear(),currentDate.getMonth()-1,1);updateMonthLabel();loadData();});
document.getElementById("nextMonth").addEventListener("click",()=>{currentDate=new Date(currentDate.getFullYear(),currentDate.getMonth()+1,1);updateMonthLabel();loadData();});
function updateMonthLabel(){document.getElementById("monthLabel").textContent=currentDate.toLocaleDateString("en-IN",{month:"long",year:"numeric"});}
document.querySelectorAll(".filter-btn").forEach(btn=>btn.addEventListener("click",()=>{
  document.querySelectorAll(".filter-btn").forEach(b=>b.classList.remove("active"));
  btn.classList.add("active");activeFilter=btn.dataset.filter;activeLegendCat=null;
  renderLegend();drawPie();renderTxList();
}));

updateMonthLabel();loadData();
</script>
